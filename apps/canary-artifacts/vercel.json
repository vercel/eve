{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm --filter eve-canary-artifacts build",
  "installCommand": "pnpm install --frozen-lockfile",
  "outputDirectory": "public",
  "rewrites": [
    { "source": "/canary/latest", "destination": "/api/canary/latest" },
    { "source": "/canary/latest.json", "destination": "/api/canary/latest.json" },
    { "source": "/canary/:sha/eve.tgz", "destination": "/api/canary/:sha/eve.tgz" }
  ]
}
