{
  "name": "eve-docs",
  "version": "0.0.1",
  "private": true,
  "description": "eve documentation site.",
  "type": "module",
  "scripts": {
    "build": "pnpm run registry:check && next build",
    "dev": "next dev --turbo",
    "start": "next start",
    "postinstall": "fumadocs-mdx",
    "translate": "npx @vercel/geistdocs translate",
    "test:unit": "vitest run --config vitest.config.ts",
    "render:eve-5": "NODE_OPTIONS=--loader=./scripts/wgsl-node-loader.mjs tsx scripts/render-eve-5.ts",
    "registry:build": "shadcn build",
    "registry:check": "pnpm run registry:build && pnpm run registry:validate && pnpm run registry:validate:instrumentation && tsc --project registry/tsconfig.json",
    "registry:validate": "tsx scripts/validate-connection-registry.ts",
    "registry:validate:instrumentation": "tsx scripts/validate-instrumentation-registry.ts"
  },
  "dependencies": {
    "@icons-pack/react-simple-icons": "13.13.0",
    "@streamdown/code": "1.1.1",
    "@vercel/analytics": "2.0.1",
    "@vercel/eve-catalog": "workspace:*",
    "@vercel/geistdocs": "1.15.2",
    "@vercel/speed-insights": "2.0.0",
    "@vgpu/core": "0.0.7",
    "@vgpu/render": "0.0.7",
    "@vgpu/wgsl": "0.0.7",
    "clsx": "2.1.1",
    "feed": "5.2.1",
    "fumadocs-core": "16.9.1",
    "fumadocs-mdx": "14.0.4",
    "fumadocs-ui": "16.9.1",
    "lil-gui": "0.21.0",
    "lucide-react": "1.16.0",
    "next": "catalog:",
    "phase": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "sonner": "2.0.7",
    "streamdown": "catalog:",
    "tailwind-merge": "3.6.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@agent-browser/eve": "^0.33.0",
    "@braintrust/otel": "^0.3.0",
    "@browserbasehq/eve": "^0.1.0",
    "@github-tools/eve-extension": "^0.1.0",
    "@jetty/eve": "^0.3.0",
    "@onkernel/eve-extension": "^0.1.3",
    "@tailwindcss/postcss": "4.3.0",
    "@types/mdx": "2.0.13",
    "@types/node": "catalog:",
    "@types/pngjs": "^6.0.5",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@upstash/agentkit-eve-extension": "^0.4.0",
    "@vercel/connect": "catalog:",
    "@vercel/otel": "catalog:",
    "@vgpu/adapter-node": "0.0.7",
    "@webgpu/types": "^0.1.69",
    "eve": "workspace:*",
    "pngjs": "^7.0.0",
    "postcss": "8.5.15",
    "shadcn": "4.16.0",
    "tailwindcss": "4.3.0",
    "tsx": "^4.21.0",
    "typescript": "6.0.3",
    "vitest": "catalog:"
  }
}
