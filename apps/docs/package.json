{
  "name": "eve-docs",
  "version": "0.0.1",
  "private": true,
  "description": "eve documentation site.",
  "type": "module",
  "scripts": {
    "build": "pnpm run registry:check && next build",
    "dev": "next dev --turbo",
    "start": "next start",
    "postinstall": "fumadocs-mdx",
    "translate": "npx @vercel/geistdocs translate",
    "test:unit": "vitest run --config vitest.config.ts",
    "render:eve-5": "NODE_OPTIONS=--loader=./scripts/wgsl-node-loader.mjs tsx scripts/render-eve-5.ts",
    "registry:build": "tsx scripts/prepare-registry-output.ts && shadcn build",
    "registry:check": "pnpm --filter @eve/agent-browser build && node --test ../../scripts/materialize-registry-release-requirements.test.mjs ../../scripts/validate-public-registry-requirements.test.mjs && node ../../scripts/validate-public-registry-requirements.mjs && pnpm run registry:build && pnpm run registry:validate && pnpm run registry:validate:channels && pnpm run registry:validate:instrumentation && pnpm run registry:validate:memory && pnpm run registry:validate:tools && tsc --project registry/tsconfig.json",
    "registry:validate": "tsx scripts/validate-connection-registry.ts",
    "registry:validate:tools": "tsx scripts/validate-tool-registry.ts",
    "registry:validate:channels": "tsx scripts/validate-channel-registry.ts",
    "registry:validate:instrumentation": "tsx scripts/validate-instrumentation-registry.ts",
    "registry:validate:memory": "tsx scripts/validate-memory-registry.ts"
  },
  "dependencies": {
    "@eve/catalog": "workspace:*",
    "@eve/recall": "workspace:*",
    "@icons-pack/react-simple-icons": "13.15.1",
    "@streamdown/code": "2.0.0",
    "@vercel/analytics": "2.0.1",
    "@vercel/geistdocs": "2.14.2",
    "@vercel/speed-insights": "2.1.0",
    "@vgpu/core": "0.0.7",
    "@vgpu/render": "0.0.7",
    "@vgpu/wgsl": "0.0.7",
    "clsx": "2.1.1",
    "feed": "6.0.0",
    "fumadocs-core": "16.2.2",
    "fumadocs-mdx": "14.0.4",
    "fumadocs-ui": "16.2.2",
    "geist": "1.7.1",
    "lil-gui": "0.21.0",
    "lucide-react": "1.72.0",
    "next": "catalog:",
    "phase": "catalog:",
    "pngjs": "^7.0.0",
    "react": "catalog:",
    "react-dom": "catalog:",
    "sonner": "2.0.8",
    "streamdown": "catalog:",
    "tailwind-merge": "3.7.0",
    "three": "0.187.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@blitzreels/eve": "^0.2.1",
    "@browserbasehq/eve": "^0.2.3",
    "@eve/agent-browser": "workspace:*",
    "@github-tools/eve-extension": "^0.13.0",
    "@jetty/eve": "^0.3.1",
    "@kybernesis/arcana": "0.7.1",
    "@mdx-js/mdx": "3.1.1",
    "@memco/eve": "0.2.0",
    "@moorcheh-ai/memanto": "0.2.31",
    "@nimble-way/eve": "0.2.0",
    "@onkernel/eve-extension": "^0.1.4",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "0.223.1",
    "@opentelemetry/sdk-trace-base": "catalog:",
    "@posthog/ai": "8.19.2",
    "@stripe/link-integrations-eve": "^0.5.0",
    "@supermemory/eve": "0.1.3",
    "@tailwindcss/postcss": "4.3.5",
    "@types/mdx": "2.0.14",
    "@types/node": "catalog:",
    "@types/pngjs": "^6.0.5",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@types/three": "0.187.0",
    "@upstash/agentkit-eve": "0.19.0",
    "@upstash/redis": "^1.41.0",
    "@vectorize-io/hindsight-eve": "^0.3.1",
    "@vercel/connect": "catalog:",
    "@vercel/otel": "catalog:",
    "@vgpu/adapter-node": "0.0.7",
    "@webgpu/types": "^0.1.74",
    "braintrust": "3.44.0",
    "chat": "4.44.0",
    "claude-mem": "15.18.1",
    "eve": "workspace:*",
    "mdast-util-mdx-jsx": "3.2.1",
    "mdast-util-to-markdown": "2.2.3",
    "postcss": "8.5.32",
    "shadcn": "4.23.0",
    "tailwindcss": "4.3.5",
    "tsx": "^4.23.15",
    "typescript": "6.0.3",
    "vitest": "catalog:"
  }
}
