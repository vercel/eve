{
  "name": "eve-docs",
  "version": "0.0.1",
  "private": true,
  "description": "eve documentation site.",
  "type": "module",
  "scripts": {
    "build": "pnpm run registry:check && next build",
    "dev": "next dev --turbo",
    "start": "next start",
    "postinstall": "fumadocs-mdx",
    "translate": "npx @vercel/geistdocs translate",
    "test:unit": "vitest run --config vitest.config.ts",
