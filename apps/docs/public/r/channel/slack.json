{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "channel/slack",
  "title": "Slack",
  "description": "Connect an eve agent to Slack with Vercel Connect or portable credentials.",
  "dependencies": [
    "@vercel/connect@0.4.2"
  ],
  "meta": {
    "eve": {
      "setup": {
        "command": "eve",
        "args": [
          "integration",
          "setup",
          "slack"
        ]
      },
      "requires": ">=0.27.8"
    }
  },
  "type": "registry:item"
}