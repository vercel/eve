# GitHub organization whose repositories the `git__gh` tool may access.
# Required for GitHub invocation. Leave empty to disable GitHub invocation and git__gh.
GITHUB_ORG=

# GitHub team slug within GITHUB_ORG, for example coding-agent-operators.
# Required for GitHub invocation. Active members receive the App's configured access.
# The GitHub App needs organization Members: read permission for the live lookup.
GITHUB_OPERATOR_TEAM=

# Optional. Vercel Connect GitHub connector UID. Default: github/coding-agent.
GITHUB_CONNECTOR=

# Optional. Comment invocation token, usually your GitHub App's slug.
# Default: coding-agent.
GITHUB_BOT_NAME=
