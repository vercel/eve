# Optional. GitHub organization or user whose repositories the `git__gh` tool
# may access. Leave empty to run without `git__gh`; the GitHub channel still works.
GITHUB_ORG=

# Optional. Vercel Connect GitHub connector UID. Default: github/coding-agent.
GITHUB_CONNECTOR=

# Optional. Comment invocation token, usually your GitHub App's slug.
# Default: coding-agent.
GITHUB_BOT_NAME=

# Optional. Vercel Connect Slack connector UID, set by the Deploy with Vercel
# button. Default: the literal in agent/channels/slack.ts (slack/coding-agent).
SLACK_CONNECTOR=
