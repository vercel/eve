    "@vercel/blob": "^2.8.2",
    "@vercel/connect": "2.9.2",
    "ai": "^7.0.150",
    "chat": "^4.43.0",
    "eve": "1.0.0-rc.17",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "~2.5.15",
    "@types/node": "~24.19.2",
    "tsx": "^4.21.0",
    "typescript": "7.0.2",
    "ultracite": "^8.0.2"
  },
  "engines": {
    "node": "24.x"
  }
