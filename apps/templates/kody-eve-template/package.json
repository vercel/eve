{
  "name": "github-digest-eve-template",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "imports": {
    "#*": "./agent/*",
    "#evals/*": "./evals/*"
  },
  "scripts": {
    "build": "eve build",
    "check": "ultracite check",
    "dev": "eve dev",
    "fix": "ultracite fix",
