# Copy this file to .env.local for local development, and fill in your values.

# Slack connector the agent posts with. Vercel Connect sets it on deploy.
# Keep slack/placeholder to run `pnpm dev` and `pnpm build` locally.
SLACK_CONNECTOR=slack/placeholder

# Drive that sessions mount and that save_to_drive and `pnpm drive:upload` write to.
# Optional; defaults to eve-drive.
DRIVE_NAME=

# Region of the Drive and of every sandbox that mounts it. A Drive's region
# can't change after it's created. Optional; defaults to iad1.
DRIVE_REGION=

# Comma-separated Slack user IDs whose profiles the agent doesn't look up,
# such as bot or service accounts. Optional.
SLACK_IDENTITY_EXCLUDED_USER_IDS=
