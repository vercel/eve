    "shadcn": "4.19.0",
    "taze": "21.1.0",
    "tsx": "4.21.0",
    "turbo": "2.10.12",
    "typescript": "6.0.3",
    "vercel": "^59.6.2",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": "24.x"
  },
  "exports": {
    "./browser-benchmark-dashboard": "./evals/browser/dashboard/index.ts"
  },
  "name": "local-vault-assistant",
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "bench:ab": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/run-browser-ab.ts",
    "bench:browser": "eve eval browser",
    "bench:compare": "node --experimental-strip-types scripts/compare-browser-benchmarks.ts",
    "bench:dashboard": "portless --name eve-browser-bench next dev evals/browser/dashboard",
    "bench:seed": "tsx scripts/seed-browser-benchmark-vault.ts",
    "build": "turbo run build:app",
    "build:app": "next build",
    "build:vercel": "next build",
    "check": "turbo run lint:app types:check:app test:app format:check knip",
    "db:check": "drizzle-kit check --config db/drizzle.config.ts",
    "db:generate": "drizzle-kit generate --config db/drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config db/drizzle.config.ts",
    "deps:check": "taze --no-github-actions --no-node-version --fail-on-outdated",
    "deploy": "turbo run deploy:app",
    "deploy:app": "eve deploy",
    "dev": "node --env-file-if-exists=.env.local scripts/dev.ts",
    "dev:app": "next dev",
    "eval": "eve eval",
    "eval:agent": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/run-agent-evals.ts",
    "eval:ci": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/run-agent-evals.ts --junit .eve/junit.xml",
    "eval:list": "eve eval --list",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "knip": "knip --config knip.config.ts",
    "lint": "turbo run lint:app",
    "lint:app": "oxlint . --deny-warnings",
    "lint:fix": "oxlint . --fix",
    "start": "turbo run start:app",
    "start:app": "next start",
    "test": "turbo run test:app",
    "test:app": "vitest run",
    "types:check": "turbo run types:check:app",
    "types:generate": "next typegen",
    "types:check:app": "tsc --noEmit -p tsconfig.json",
    "build:eve": "eve build",
    "dev:eve": "eve dev",
    "start:eve": "eve start",
    "test:runtime": "node --experimental-strip-types scripts/run-runtime-smoke.ts"
  },
  "version": "0.0.0",
  "type": "module"
}
