# ./scripts/setup.sh generates these and writes .env.local and Vercel environment variables.
EVE_APP_PASSWORD=
EVE_START_AGENT_TOKEN=
EVE_START_AGENT_ID=
EVE_START_APP_BYPASS_TOKEN=

# Optional external Postgres override. Otherwise hosted storage uses Sandbox/Drive SQLite.
DATABASE_URL=
# Optional stable origin or phone-reachable local development URL.
EVE_START_APP_URL=
# Optional server-only Expo push security token.
EXPO_ACCESS_TOKEN=
