{
  "name": "eve-commerce-platform-template",
  "version": "0.1.0",
  "private": true,
  "description": "A self-hosted, multi-tenant commerce platform built with eve for shopping over iMessage.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "pnpm db:up && pnpm db:migrate && next dev --hostname 127.0.0.1",
    "dev:agent": "eve dev",
    "build": "eve build && next build",
    "build:vercel": "pnpm db:migrate --vercel-build && next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit -p tsconfig.json",
    "db:up": "docker compose up --detach --wait",
    "db:down": "docker compose down",
    "db:generate": "drizzle-kit generate --config drizzle.postgres.config.ts",
    "db:migrate": "node scripts/db-migrate.ts",
    "deploy": "eve deploy",
    "eval": "node --env-file-if-exists=.env.local scripts/eval.ts",
    "eval:list": "eve eval --list",
    "test:watches": "node --test lib/watches/*.test.ts"
  },
  "dependencies": {
    "@agent-cards/commerce-sdk": "0.23.2",
    "@linqapp/sdk": "0.47.1",
    "@onkernel/browser-loop": "0.12.0",
    "@onkernel/sdk": "^0.96.0",
    "@opentelemetry/api": "^1.9.1",
    "@t3-oss/env-nextjs": "0.13.11",
    "@tailwindcss/postcss": "4.3.3",
    "@ui-sdk/core": "0.1.0-beta.7",
    "@ui-sdk/react": "0.1.0-beta.7",
    "@vercel/blob": "2.8.0",
    "@vercel/connect": "^2.7.0",
    "@vercel/oidc": "3.8.5",
    "ai": "^7.0.159",
    "better-auth": "1.7.7",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "^0.45.2",
    "eve": "1.1.0",
    "ipaddr.js": "2.2.0",
    "libphonenumber-js": "^1.13.15",
    "lucide-react": "1.34.0",
    "next": "16.4.5",
    "next-themes": "0.4.6",
    "parse5": "8.0.1",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "tailwind-merge": "3.6.0",
    "tailwindcss": "4.3.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@next/env": "16.4.5",
    "@types/node": "24.13.3",
    "@types/pg": "^8.23.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "chat": "4.43.0",
    "drizzle-kit": "^0.31.10",
    "just-bash": "3.6.1",
    "tw-animate-css": "1.4.0",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@11.24.0"
}
