# Copy to .env.local for local development. On Vercel, the Deploy button and
# Marketplace integrations provide most of these automatically.

# Postgres. `pnpm dev` starts this database with Docker Compose. On Vercel, the
# Neon integration injects both URLs; migrations use the unpooled one.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54329/evey
DATABASE_URL_UNPOOLED=postgresql://postgres:postgres@127.0.0.1:54329/evey

# Optional browser fallback. Create a key at https://kernel.sh, or let the
# Kernel integration inject it on Vercel.
KERNEL_API_KEY=

# Models through Vercel AI Gateway. Not needed on Vercel, which uses OIDC.
AI_GATEWAY_API_KEY=

# Agentcard purchasing. Get sandbox credentials with:
#   npx agent-cards credentials --mode sandbox
# The webhook secret is shown once when you create the endpoint for
# https://<your-deployment>/agentcard/webhooks in the Agentcard dashboard.
AGENTCARD_CLIENT_ID=
AGENTCARD_CLIENT_SECRET=
AGENTCARD_WEBHOOK_SECRET=

# iMessage through a Linq connector in Vercel Connect, such as linq/evey.
# LINQ_PHONE_NUMBER (E.164) optionally overrides the displayed Linq line number.
LINQ_CONNECTOR=
LINQ_PHONE_NUMBER=

# Private Vercel Blob storage for memory, product images, and the generated
# auth secret. Vercel injects BLOB_STORE_ID; elsewhere, set a read-write token.
BLOB_STORE_ID=
BLOB_READ_WRITE_TOKEN=

# On Vercel, the auth secret is generated in private Blob storage and the
# URL comes from system variables. For a production build outside Vercel,
# set an explicit origin and auth secret (`openssl rand -base64 32`).
# `pnpm dev` supplies local-only defaults.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=

# Optional loopback-only development sign-in without a text. Never enable
# this when exposing the development server through a tunnel or proxy.
# EVEY_LOCAL_PHONE_AUTH=1
