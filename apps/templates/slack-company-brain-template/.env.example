# Local AI Gateway authentication, unless you link a Vercel project and use OIDC.
# AI_GATEWAY_API_KEY=your_api_key_here

# The Vercel Connect Slack connector UID. `eve add channel/slack` provisions it.
SLACK_CONNECTOR=slack/company-brain

# Your Slack workspace ID (starts with T). When set, only members of this
# workspace can start a conversation, which keeps Slack Connect guests out.
SLACK_TEAM_ID=
