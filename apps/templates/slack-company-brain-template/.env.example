# Local AI Gateway authentication, unless you link a Vercel project and use OIDC.
# AI_GATEWAY_API_KEY=your_api_key_here

# The Vercel Connect Slack connector UID that `vercel connect create slack`
# printed. Default: slack/company-brain.
SLACK_CONNECTOR=

# Your Slack workspace ID (starts with T). When set, only members of this
# workspace can start a conversation or answer approvals, which keeps people
# from other companies in Slack Connect channels out. Workspace guests are
# always refused.
SLACK_TEAM_ID=

# Optional. Limits GitHub access to repositories owned by this organization or
# user, for an app installed on more than one account.
GITHUB_ORG=
