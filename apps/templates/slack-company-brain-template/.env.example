# Local AI Gateway authentication, unless you link a Vercel project and use OIDC.
# AI_GATEWAY_API_KEY=your_api_key_here

# The Vercel Connect Slack connector UID that `vercel connect create slack`
# printed. Default: slack/company-brain.
SLACK_CONNECTOR=

# Your Slack workspace ID (starts with T). When set, only members of this
# workspace can start a conversation or answer approvals, which keeps Slack
# Connect guests out.
SLACK_TEAM_ID=

# Optional. GitHub organization or user whose repositories the agent may read
# and open pull requests against. Leave empty to run without GitHub access.
GITHUB_ORG=

# Optional. Vercel Connect GitHub connector UID. Default: github/company-brain.
GITHUB_CONNECTOR=
