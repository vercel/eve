# Shared password for the deployed app (16+ characters recommended).
# Required in production: without it, the app and the agent fail closed.
# Leave empty locally to use the local development identity.
EVE_CHAT_PASSWORD=

# Postgres for the FastAPI backend. On Vercel, the Neon integration sets this.
# Leave empty locally to use a SQLite file at apps/api/.data/dev.sqlite3.
# Deployments without it return 503 from database-backed endpoints.
DATABASE_URL=

# Model access through Vercel AI Gateway. Not needed on Vercel (the deployment
# uses project OIDC) or locally after `eve link` / `vercel env pull`.
AI_GATEWAY_API_KEY=

# Optional: set when Deployment Protection is on and you connect with
# `eve remote connect` or call /eve/v1/* from outside the browser.
VERCEL_AUTOMATION_BYPASS_SECRET=

# Optional: only for `pnpm dev:web` / `pnpm dev:eve` without `vercel dev`.
# Under Vercel and `pnpm dev:all`, the `api` service binding injects it.
# BACKEND_URL=http://127.0.0.1:8000
