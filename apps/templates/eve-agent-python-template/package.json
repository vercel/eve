{
  "name": "eve-nextjs-fastapi",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#*": "./agent/*"
  },
  "scripts": {
    "dev": "next dev apps/web",
    "dev:all": "vercel dev --local",
    "dev:web": "next dev apps/web",
    "dev:eve": "eve dev",
    "dev:api": "uv run --directory apps/api fastapi dev main.py --port 8000",
    "build": "pnpm build:eve && pnpm build:web",
    "build:eve": "eve build",
    "build:web": "next build apps/web",
    "typecheck": "next typegen apps/web && tsc --noEmit -p apps/web/tsconfig.json && tsc --noEmit -p tsconfig.json",
    "test": "uv run --directory apps/api pytest",
    "lint:api": "uv run --directory apps/api ruff check . && uv run --directory apps/api ruff format --check ."
  },
  "dependencies": {
    "@json-render/core": "0.21.0",
    "@json-render/react": "0.21.0",
    "@json-render/shadcn": "0.21.0",
    "@radix-ui/react-use-controllable-state": "1.2.6",
    "@shadcn/react": "0.3.1",
    "@streamdown/cjk": "1.0.4",
    "@streamdown/code": "1.1.1",
    "@streamdown/math": "1.0.3",
    "@streamdown/mermaid": "1.0.3",
    "@tailwindcss/postcss": "4.3.3",
    "@tanstack/react-table": "9.2.8",
    "ai": "7.0.137",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "eve": "1.0.0-rc.0",
    "lucide-react": "1.55.0",
    "motion": "12.43.0",
    "nanoid": "5.1.16",
    "next": "16.4.0",
    "radix-ui": "1.7.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "shiki": "3.23.0",
    "streamdown": "2.7.0",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "use-stick-to-bottom": "1.1.6",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "just-bash": "3.6.0",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.25.0"
}
