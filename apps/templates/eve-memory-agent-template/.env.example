# Required for Slack: a Vercel Connect Slack connector attached to this project.
SLACK_CONNECTOR=slack/memory-agent

# Optional comma-separated Slack user IDs to omit from identity enrichment.
SLACK_IDENTITY_EXCLUDED_USER_IDS=

# Memory storage on Vercel uses a private Blob store. Create one with
# `vercel blob create-store memory-agent-memory --access private --yes`.
# pnpm dev keeps memory in process and needs no configuration.