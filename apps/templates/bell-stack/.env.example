# Server-only credentials. Never commit .env.
OPENAI_API_KEY=
# Optional public-web search and extraction.
PARALLEL_API_KEY=
BROWSERBASE_API_KEY=
# Optional: the project can be inferred from the Browserbase API key.
BROWSERBASE_PROJECT_ID=
BELL_MODEL=gpt-5.6-sol
BELL_DEMO_URL=https://bell-stack-demo-site.vercel.app/protected
STAGEHAND_BROWSER=browserbase
# Hosted browser logging and recording are always disabled.
# Optional browser runtime features:
# Local handoff only. For phone use, set this to Bell's deployed HTTPS origin.
BELL_PUBLIC_URL=http://127.0.0.1:4320
BELL_HANDOFF_SECRET=
# Optional HTTP Basic access for one trusted operator; password must be at least 32 bytes.
BELL_OPERATOR_USERNAME=
BELL_OPERATOR_PASSWORD=
# 1Password uses the SDK by default. Select cli explicitly for existing CLI setups.
BELL_ONEPASSWORD_BACKEND=sdk
# SDK desktop access: sidebar account name or account UUID. CLI access: account UUID/address.
OP_ACCOUNT=
# Hosted access: a service-account token takes precedence over OP_ACCOUNT.
OP_SERVICE_ACCOUNT_TOKEN=
# Existing local encrypted vault files remain readable; no vault-writing API is provided.
BELL_VAULT_FILE=.bell/vault.enc.json
BELL_VAULT_MASTER_KEY=
# Personal 1Password Agentic Autofill for private Linq senders. See docs/onepassword.md.
# Keep disabled until Stagehand and 1Password can load together in a hosted session.
ONEPASSWORD_ENABLED=false
# Apply migrations/002_onepassword.sql and use a session-pooled PostgreSQL connection.
# Set the registered HTTPS callback URL for your own Bell deployment.
ONEPASSWORD_REDIRECT_URI=
ONEPASSWORD_CLIENT_ID=
ONEPASSWORD_CLIENT_SECRET=
# Generate once with openssl rand -base64 32; keep stable and backed up.
ONEPASSWORD_TOKEN_ENCRYPTION_KEY=
# Leave unset until hosted extension support is fixed. Setting this disables reusable Contexts.
BROWSERBASE_1PASSWORD_EXTENSION_ID=
# Optional Linq messaging. Keep tokens and your personal number in .env.local.
LINQ_API_KEY=
LINQ_WEBHOOK_SECRET=
# Your Linq receiving line in E.164 format, starting with + and country code.
BELL_LINQ_PHONE_NUMBER=
# Comma-separated E.164 numbers. Empty accepts nobody.
BELL_LINQ_ALLOWED_SENDERS=

# Baselayer sandbox. The principal must be current in the API key's organization.
BASELAYER_API_KEY=
BASELAYER_PRINCIPAL_REF=
BASELAYER_ALLOWED_ORIGINS=https://bell-stack-demo-site.vercel.app

# Optional database-free Link sandbox for one verified Linq principal.
# Inject the access token into the process environment; do not save it in this file.
LINK_SANDBOX=1
LINK_SANDBOX_ACCESS_TOKEN=
LINK_SANDBOX_PRINCIPAL_ID=

# Optional real Link OAuth for allowlisted Linq senders (LINK_SANDBOX=0).
# Register <BELL_PUBLIC_URL>/api/link/oauth/callback with your Link OAuth client.
# Apply migrations/001_link_oauth.sql before connecting a wallet. See docs/link.md.
DATABASE_URL=
LINK_CLIENT_ID=
LINK_CLIENT_SECRET=
STRIPE_PUBLISHABLE_KEY=
# Generate once: openssl rand -base64 32. Keep stable across instances and restarts.
LINK_TOKEN_ENCRYPTION_KEY=

# Exact trusted checkout/frame origins per approved merchant (JSON object).
LINK_CHECKOUT_ORIGINS={}

# Optional persistent public-web watches. Apply migrations/004_parallel_monitors.sql and 005_monitor_frequency.sql.
# Copy the Parallel organization's secret from Settings > Webhooks.
PARALLEL_WEBHOOK_SECRET=
# Generate a random worker bearer secret; configure a scheduler separately.
CRON_SECRET=
