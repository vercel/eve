# Required: Contentful Management API token and allowed spaces.
CONTENTFUL_MANAGEMENT_TOKEN=
# Comma-separated raw space IDs, or a JSON alias map such as {"website":"your-space-id"}.
CONTENTFUL_SPACE_IDS=your-space-id
CONTENTFUL_ENVIRONMENT_ID=master
# Optional. Unset uses each environment's default locale.
# CONTENTFUL_LOCALE=en-US

# Required for Slack: a Vercel Connect Slack connector attached to this project.
SLACK_CONNECTOR=slack/contentful-agent
# Optional: respond to new human posts in these channels without a mention.
# SLACK_AUTO_REPLY_CHANNEL_IDS=C0123456789,C0987654321

# Explicit component types can publish without an approval prompt.
# Every other type is treated as a page and created as a draft.
CONTENTFUL_COMPONENT_TYPES={}
# Example: {"your-space-id":["author","imageBlock","callout"]}

# Optional public website URL lookup. Route spaceId values are raw IDs, not aliases.
# CONTENTFUL_PUBLIC_ORIGIN=https://www.example.com
CONTENTFUL_PAGE_ROUTES={}
# Example: {"article":{"spaceId":"your-space-id","contentTypeId":"article","urls":[{"prefix":"articles"}]}}

# Optional fields that require block patches rather than whole-value set/unset.
# Initial page creation may set these fields. IDs use the configured space alias or ID.
CONTENTFUL_PROTECTED_FIELDS=[]
# Example: ["your-space-id/article/body"]

# Optional: Vercel Drive storing a searchable copy of all configured Contentful spaces.
# Defaults to contentful-mirror.
CONTENTFUL_MIRROR_DRIVE_NAME=contentful-mirror
# Optional: region for the Drive and the agent's sandbox. Defaults to iad1.
CONTENTFUL_MIRROR_REGION=iad1

# Optional comma-separated Slack user IDs to omit from identity enrichment.
SLACK_IDENTITY_EXCLUDED_USER_IDS=
