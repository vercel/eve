    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/node": "24.x",
    "eslint-plugin-jsdoc": "^65.2.0",
    "eslint-plugin-tsdoc": "^0.5.4",
    "knip": "^6.40.0",
    "lefthook": "^2.1.17",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "typescript": "7.0.2",
    "ultracite": "^7.12.4",
    "vitest": "^5.0.3"
