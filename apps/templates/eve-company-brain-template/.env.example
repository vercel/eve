# Local path or md:jaffle_shop. Both use the same DuckDB client and SQL.
DUCKDB_CONNECTION=./data/jaffle_shop.duckdb

# Required for MotherDuck. Use writer credentials only for pnpm data:build,
# then switch to a read-only Read Scaling token for the running agent.
# motherduck_token=your_access_token_here

# Local AI Gateway authentication, unless using Vercel project OIDC.
# AI_GATEWAY_API_KEY=your_api_key_here

# Optional HTTP operator access in development. Without a password, HTTP
# session routes reject all callers. Slack does not use this credential.
# Generate a random password as shown in the README; do not deploy it.
# COMPANY_BRAIN_HTTP_PASSWORD=your_random_password_here

# Provision with pnpm exec eve add channel/slack.
SLACK_CONNECTOR=slack/company-brain
# Slack invocation and every model tool fail closed without all three values.
SLACK_TEAM_ID=
SLACK_ALLOWED_USER_IDS=
# Include each permitted channel or DM conversation ID. No wildcards.
SLACK_ALLOWED_CHANNEL_IDS=
