# Required. GPT-Live-1 client secrets can only be minted with an AI Gateway API
# key (OIDC is not accepted for that endpoint).
AI_GATEWAY_API_KEY=

# Starter mode. Use a strong value (16+ characters recommended).
EVE_VOICE_PASSWORD=

# Optional production mode. Configure every value in this section to switch
# from password auth to Sign in with Vercel, backed by Neon and Upstash.
DATABASE_URL=
BETTER_AUTH_SECRET=
NEXT_PUBLIC_VERCEL_APP_CLIENT_ID=
VERCEL_APP_CLIENT_SECRET=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Optional: override the app origin for a custom production domain.
BETTER_AUTH_URL=
