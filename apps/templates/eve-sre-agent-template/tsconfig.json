{
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"],
    "declaration": false,
    "noEmit": true,
    "outDir": "dist",
    "rootDir": "."
  },
  "include": ["agent/**/*.ts", "scripts/**/*.ts", ".eve/**/*.d.ts"]
}
