# Connector UIDs. Defaults match `vercel connect create <type> --name sre`.
# Set these only when `vercel connect list` shows different UIDs.
SLACK_CONNECTOR=slack/sre
GITHUB_CONNECTOR=github/sre
DATADOG_CONNECTOR=datadog/sre
SRE_VERCEL_CONNECTOR=vercel/sre

# Shared secret for automated investigations. Required for POST /v1/investigate.
# Use a long random string (32+ bytes). Example:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WEBHOOK_SECRET=

# Datadog site. Regional examples are datadoghq.eu and us5.datadoghq.com.
DD_SITE=datadoghq.com
