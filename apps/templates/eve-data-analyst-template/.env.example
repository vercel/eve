# Copy this file to .env.local for local development, and fill in your values.

# Connection string for your Postgres database, as a user that can create schemas and roles.
# Each deploy, and `pnpm db:setup` on your machine, uses it to set up the database.
# Include the password, because the read-only user's password is calculated from it.
DATABASE_URL=postgres://user:password@host:5432/database

# Set to true or 1 to load the demo data, which refreshes on deploys after it's a week old.
ANALYST_SEED_DEMO_DATA=true

# Optional connection string for a read-only user you manage yourself with
# `pnpm db:setup-sql --apply`. When it's set, deploys skip the setup step.
ANALYST_DATABASE_URL=

# Database schemas the agent explores, separated by commas. The default is analytics, the demo schema.
ANALYST_SCHEMAS=analytics

# Optional schemas from ANALYST_SCHEMAS whose tables every role can read. The default is every schema in ANALYST_SCHEMAS.
# Leave a schema out to keep it to the roles you grant yourself.
ANALYST_SHARED_SCHEMAS=

# Time zone for periods such as "last month", and for timestamps in answers. The default is UTC.
ANALYST_TIMEZONE=UTC

# Database role for everyone ANALYST_ROLE_MAP leaves out. The default is analyst_readonly.
# An empty value limits access to the people and channels in ANALYST_ROLE_MAP.
ANALYST_DEFAULT_ROLE=analyst_readonly

# Optional JSON object that gives Slack users and channels their own database roles, such as
# {"U0456EFGH":"analyst_exec","C0789IJKL":"analyst_finance"}. An empty role turns off access.
ANALYST_ROLE_MAP={}

# Queries with an estimated cost above this value wait for the asker's approval.
# Run `pnpm db:doctor` for a suggested value.
ANALYST_APPROVAL_COST=1000000

# Time limit for each query, in milliseconds.
ANALYST_STATEMENT_TIMEOUT_MS=20000

# Rows the agent reads from each query result.
ANALYST_MAX_ROWS=500

# Slack connector the agent posts with. Vercel Connect sets it on deploy.
# Keep slack/placeholder to run `pnpm dev` and `pnpm build` locally.
SLACK_CONNECTOR=slack/placeholder

# Optional Slack channel IDs, separated by commas, where the agent answers every new post.
SLACK_AUTO_REPLY_CHANNEL_IDS=

# Optional Slack user IDs, separated by commas, to leave out of profile lookups.
SLACK_IDENTITY_EXCLUDED_USER_IDS=

# Optional password for a read-only user created with `pnpm db:setup-sql`. The script generates one when it's empty.
ANALYST_LOGIN_PASSWORD=
