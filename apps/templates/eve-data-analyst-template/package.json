{
  "name": "eve-data-analyst",
  "version": "0.0.0",
  "type": "module",
  "imports": {
    "#*": "./agent/*",
    "#evals/*": "./evals/*",
    "#lib/*": "./agent/lib/*.ts",
    "#scripts/*": "./scripts/*.ts"
  },
  "scripts": {
    "build": "eve build",
    "vercel-build": "node scripts/setup-on-deploy.ts && eve build",
    "deploy": "eve deploy",
    "dev": "eve dev",
    "eval": "eve eval",
    "db:setup": "node --env-file-if-exists=.env.local scripts/setup-on-deploy.ts",
    "db:seed": "node --env-file-if-exists=.env.local scripts/seed.ts",
    "db:setup-sql": "node --env-file-if-exists=.env.local scripts/setup-sql.ts",
    "db:doctor": "node --env-file-if-exists=.env.local scripts/doctor.ts",
    "typecheck": "tsc",
    "check": "oxlint --config lint.config.ts && oxfmt --check",
    "fix": "oxlint --config lint.config.ts --fix && oxfmt --write",
    "test": "vitest run",
    "test:smoke": "vitest run --config vitest.config.ts agent/lib/analyst/bounded-query.test.ts",
    "validate": "pnpm run check && pnpm run typecheck && pnpm run test && pnpm run knip",
    "knip": "knip"
  },
  "dependencies": {
    "@vercel/connect": "2.2.0",
    "ai": "^7.0.128",
    "eve": "1.0.0-rc.17",
    "just-bash": "3.1.0",
    "pg": "^8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.x",
    "@types/pg": "^8.23.1",
    "eslint-plugin-jsdoc": "^65.2.1",
    "eslint-plugin-tsdoc": "^0.5.4",
    "knip": "^6.40.0",
    "lefthook": "^2.2.1",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "typescript": "7.0.2",
    "ultracite": "7.12.4",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": "24.x"
  }
}
