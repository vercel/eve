{
  "name": "@eve/custom-skills",
  "version": "0.0.0",
  "private": true,
  "description": "Source of the eve/experimental/extensions/custom-skills extension: versioned skills that the people talking to an agent save for themselves or their channel.",
  "type": "module",
  "exports": {
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "pnpm run test:unit && pnpm run test:integration",
    "test:unit": "node --test \"test/unit/*.test.ts\"",
    "test:integration": "node --test \"test/integration/*.test.ts\"",
    "typecheck": "tsc"
  },
  "dependencies": {
    "eve": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=24"
  },
  "eve": {
    "extension": {
      "source": "./extension",
      "dist": "./dist/extension"
    }
  }
}
