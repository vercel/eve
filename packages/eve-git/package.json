{
  "name": "@eve/git",
  "version": "0.0.0",
  "private": true,
  "description": "Source of the eve/extensions/git extension: GitHub pull request workflow, with optional Connect-brokered gh access and signed commits.",
  "type": "module",
  "exports": {
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "pnpm run test:unit && pnpm run test:integration",
    "test:unit": "node --test \"test/unit/*.test.ts\"",
    "test:integration": "node --test \"test/integration/*.test.ts\"",
    "test:scenario": "node --test \"test/scenario/*.test.ts\"",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@vercel/connect": "catalog:",
    "eve": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "typescript-compiler": "npm:typescript@6.0.3"
  },
  "engines": {
    "node": ">=24"
  },
  "eve": {
    "extension": {
      "source": "./extension",
      "dist": "./dist/extension"
    }
  }
}
