{
  "name": "@eve/loops",
  "version": "0.0.0",
  "private": true,
  "description": "Source of the eve/extensions/loops extension: notices when a turn repeats the same tool calls without progress, nudges the model, then stops the turn.",
  "type": "module",
  "exports": {
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "pnpm run test:unit",
    "test:unit": "node --test \"test/unit/*.test.ts\"",
    "typecheck": "tsc"
  },
  "dependencies": {
    "eve": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=24"
  },
  "eve": {
    "extension": {
      "source": "./extension",
      "dist": "./dist/extension"
    }
  }
}
