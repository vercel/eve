{
  "name": "@eve/json-render",
  "version": "0.0.0",
  "private": true,
  "description": "eve extension that answers with json-render cards: a card tool and a renderer that draws its cards natively in Slack and Chat SDK channels",
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.mjs"
    },
    "./tools": {
      "types": "./dist/tools/index.d.ts",
      "default": "./dist/tools/index.mjs"
    }
  },
  "scripts": {
    "build": "eve extension build",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@json-render/chat": "0.22.0",
    "@json-render/core": "0.22.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "chat": "4.42.0",
    "eve": "workspace:*",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "eve": ">=1.0.0-rc.1"
  },
  "engines": {
    "node": ">=24"
  },
  "eve": {
    "extension": {
      "source": "./extension",
      "dist": "./dist/extension"
    }
  }
}
