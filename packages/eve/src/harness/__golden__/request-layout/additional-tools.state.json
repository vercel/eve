    {
      "content": "Your connections have more tools than are loaded here. Before saying you have no tool for a task, look for one with eve__search, which searches your own catalog, not the web. Call them with eve__tool({ name, input }).\nConnections, whose tools are named <connection>__<tool>; search one connection's tools with \"<connection>__\":\n- linear: Linear issues for the release team.",
      "kind": "context.state",
      "role": "user"
    },
    {
      "content": "Thanks.",
      "kind": "user",
      "metadata": {
        "eve.turn": "turn_1"
      },
      "role": "user"
    },
    {
      "content": "",
      "providerOptions": {
        "openai": {
          "additionalTools": [
            {
              "description": "Search your own catalog for tools, agents, skills, and connected services that aren't in your tool list. Use it when nothing in your tool list fits the request; it doesn't search the web. A result with `tool` has the exact name, description, and TypeScript signature: call it with eve__tool({ name, input }). `searched` counts the entries the query covered, and `remaining` counts the matches past `limit`: when `remaining` is 0, nothing else the query covered matched. Connections under `unavailable` weren't searched. When you already know a name or connection, from the catalog listing, an earlier result, or an error, search it directly: the exact name, or \"<connection>__\", which is faster and returns only that connection's tools. A connection that needs sign-in appears as a tool named after the connection: calling it with eve__tool({ name }) asks the user to sign in. `searched` counts its tools only after sign-in.",
              "name": "eve__search",
              "parameters": {
                "additionalProperties": false,
                "properties": {
                  "limit": {
                    "description": "Maximum results, best matches first. Defaults to 10.",
                    "maximum": 50,
                    "minimum": 1,
                    "type": "integer"
                  },
                  "query": {
                    "description": "Words describing the capability, such as 'list open issues'; an exact name; or a namespace prefix such as 'linear__', which searches only that connection's tools.",
                    "minLength": 1,
                    "type": "string"
                  }
                },
                "required": [
                  "query"
                ],
                "type": "object"
              },
              "strict": false,
              "type": "function"
            },
            {
              "description": "Call a tool that isn't in your tool list by its exact name from eve__search, with `input` matching its signature. Prefer connected services over web search or general knowledge when a request relates to them.",
              "name": "eve__tool",
              "parameters": {
                "additionalProperties": false,
                "properties": {
                  "input": {
                    "description": "Arguments matching the tool's signature. Defaults to {}.",
                    "type": "object"
                  },
                  "name": {
                    "description": "The tool's exact name, as eve__search returns it.",
                    "type": "string"
                  }
                },
                "required": [
                  "name"
                ],
                "type": "object"
              },
              "strict": false,
              "type": "function"
            }
          ]
        }
      },
