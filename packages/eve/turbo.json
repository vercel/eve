{
  "extends": ["//"],
  "tasks": {
    "build": {
      "dependsOn": ["$TURBO_EXTENDS$", "build:compiled"],
      "inputs": [
        "$TURBO_EXTENDS$",
        "$TURBO_ROOT$/packages/eve-code/extension/**",
        "$TURBO_ROOT$/packages/eve-git/extension/**",
        "$TURBO_ROOT$/packages/eve-computer-use/extension/**",
        "!.generated/**",
        "!src/extensions/code/extension/**",
        "!src/extensions/git/extension/**",
        "!src/computer-use/extension/**"
      ]
    },
    "build:compiled": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/packages/eve-code/extension/**",
        "$TURBO_ROOT$/packages/eve-git/extension/**",
        "$TURBO_ROOT$/packages/eve-computer-use/extension/**",
        "!.generated/**",
        "!src/extensions/code/extension/**",
        "!src/extensions/git/extension/**",
        "!src/computer-use/extension/**"
      ],
      "outputs": [
        ".generated/compiled/**",
        "src/extensions/code/extension/**",
        "src/extensions/git/extension/**",
        "src/computer-use/extension/**"
      ]
    },
    "build:js": {
      "dependsOn": ["build:compiled"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/packages/eve-code/extension/**",
        "$TURBO_ROOT$/packages/eve-git/extension/**",
        "$TURBO_ROOT$/packages/eve-computer-use/extension/**",
        "!.generated/**",
        "!src/extensions/code/extension/**",
        "!src/extensions/git/extension/**",
        "!src/computer-use/extension/**"
      ],
      "outputs": ["dist/**"]
    },
    "build:types": {
      "dependsOn": ["$TURBO_EXTENDS$", "build:compiled"],
      "inputs": [
        "$TURBO_EXTENDS$",
        "$TURBO_ROOT$/packages/eve-code/extension/**",
        "$TURBO_ROOT$/packages/eve-git/extension/**",
        "$TURBO_ROOT$/packages/eve-computer-use/extension/**",
        "!.generated/**",
        "!src/extensions/code/extension/**",
        "!src/extensions/git/extension/**",
        "!src/computer-use/extension/**"
      ]
    },
    "typecheck": {
      "dependsOn": ["$TURBO_EXTENDS$", "build:compiled"],
      "inputs": [
        "$TURBO_EXTENDS$",
        "$TURBO_ROOT$/packages/eve-code/extension/**",
        "$TURBO_ROOT$/packages/eve-git/extension/**",
        "$TURBO_ROOT$/packages/eve-computer-use/extension/**",
        "!.generated/**",
        "!src/extensions/code/extension/**",
        "!src/extensions/git/extension/**",
        "!src/computer-use/extension/**"
      ]
    },
    "test:unit": {
      "dependsOn": ["build:compiled"]
    },
    "test:integration": {
      "dependsOn": ["build"]
    },
    "test:scenario": {
      "dependsOn": ["build"]
    },
    "test:webchat": {
      "cache": false,
      "dependsOn": ["build:js"]
    },
    "test:framework-fixtures": {
      "cache": false,
      "dependsOn": ["build:compiled"]
    },
    "test:tui": {
      "cache": false,
      "dependsOn": ["build:js"]
    },
    "test:watch": {
      "cache": false,
      "dependsOn": ["build:compiled"],
      "persistent": true
    }
  }
}
