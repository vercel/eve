{
  "name": "@eve/bench",
  "version": "0.0.0",
  "private": true,
  "description": "Terminal-Bench harness benchmarks for eve.",
  "bin": {
    "eve-bench": "./src/cli.ts"
  },
  "type": "module",
  "scripts": {
    "bench": "node src/cli.ts",
    "test": "pnpm run typecheck && pnpm run test:unit && pnpm run test:integration",
    "test:unit": "node --test src/core/*.test.ts src/harnesses/*/*.test.ts",
    "test:integration": "node test/posix-only.ts test/scenarios/*.test.ts src/tools/*.test.ts",
    "test:scenario": "node test/posix-only.ts test/scenarios/*.test.ts src/tools/*.test.ts",
    "test:stress": "node --test test/stress/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "eve": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=24"
  }
}
