  "compilerOptions": {
    "target": "ES2024",
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "types": ["node", "eve/workflow-modules"]
  },
  "include": ["extension/**/*.ts", "test/**/*.ts", "vitest.unit.config.ts"]
}
