{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "ci": {
    "bootstrapping": {
      "installCommand": "pnpm install --frozen-lockfile && node scripts/install-ci-tools.mjs",
      "installEnv": {}
    },
    "tasks": [
      {
        "name": "build",
        "env": {
          "EVE_TELEMETRY_DISABLED": {
            "constant": {
              "value": "1"
            }
          }
        }
      },
      {
        "name": "typecheck",
        "env": {
          "EVE_TELEMETRY_DISABLED": {
            "constant": {
              "value": "1"
            }
          }
        }
      },
      {
        "name": "test:public-types",
        "env": {
          "EVE_TELEMETRY_DISABLED": {
            "constant": {
              "value": "1"
            }
          }
        }
      },
      {
        "name": "check:templates",
        "env": {
          "EVE_TELEMETRY_DISABLED": {
            "constant": {
              "value": "1"
            }
          }
        }
      },
      {
        "name": "e2e:postgres",
        "env": {
          "EVE_TELEMETRY_DISABLED": {
            "constant": {
              "value": "1"
            }
          }
        }
      }
    ]
  }
}
