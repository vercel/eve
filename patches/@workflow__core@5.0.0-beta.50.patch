+// A released writer's accepted prefix must precede step completion. Polling
+// alone is insufficient: it can resolve before the step first takes the lock,
+// and the executor's best-effort ops timeout can let a later writer overtake it.
+export async function flushReleasedWritables(ops) {
+    await Promise.all(ops.map(async (op) => {
+        const entry = writableOperations.get(op);
+        if (!entry || entry.writable.locked) return;
+        // Let the serialization pipe consume its final accepted write before
+        // testing its sink's in-flight count and durability barrier.
+        await new Promise((resolve) => setTimeout(resolve, 0));
+        while (entry.state.pendingOps > 0) {
+            await new Promise((resolve) => setTimeout(resolve, 0));
+        }
+        await entry.state.drainBarrier?.();
+    }));
+}
