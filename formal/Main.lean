import Eve.StepDecision

open Eve.StepDecision

/-- The state numbered `n`, its parts read from the high bit down, in `State`'s order. -/
def stateOf (n : Nat) : State :=
  let bit (i : Nat) := n.testBit (7 - i)
  ⟨bit 0, bit 1, bit 2, bit 3, bit 4, bit 5, bit 6, bit 7⟩

def bits (s : State) : String :=
  " ".intercalate <| [s.ended, s.turnOpen, s.again, s.requests, s.signIns, s.calls, s.dispatch,
    s.tasks].map fun b => if b then "1" else "0"

def render : Decision → String
  | .done => "end"
  | .run => "run"
  | .wait .person => "wait person"
  | .wait (.calls false) => "wait calls"
  | .wait (.calls true) => "wait calls dispatch"
  | .wait .tasks => "wait tasks"
  | .park => "park"
  | .parkOpen => "park open"

/-- Prints the decision for every state as the TypeScript module `step-decision.test.ts` reads.
`dispatch` means something only with `calls`, so states that set it alone are left out. -/
def main : IO Unit := do
  IO.println "// Generated by `lake exe eve-formal` in `formal/` from `Eve/StepDecision.lean`."
  IO.println "// Each row is a `StepState`, by which of its parts are set, and the decision for it:"
  IO.println "// ended turnOpen again requests signIns calls dispatch tasks -> decision"
  IO.println ""
  IO.println "export const STEP_DECISIONS: readonly string[] = ["
  for n in List.range 256 do
    let s := stateOf n
    unless !s.calls && s.dispatch do
      IO.println s!"  \"{bits s} -> {render (decideStep s)}\","
  IO.println "];"
