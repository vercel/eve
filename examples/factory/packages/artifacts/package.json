{
  "name": "@factory/artifacts",
  "version": "0.0.0",
  "private": true,
  "description": "Handoff-artifact tools for factory stations, mounted as an eve extension.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.mjs"
    },
    "./tools": {
      "types": "./dist/tools/index.d.ts",
      "default": "./dist/tools/index.mjs"
    }
  },
  "scripts": {
    "build": "eve extension build"
  },
  "dependencies": {
    "@vercel/blob": "^2.8.0",
    "eve": "workspace:*",
    "zod": "catalog:"
  },
  "eve": {
    "extension": {
      "source": "./extension",
      "dist": "./dist/extension"
    }
  }
}
