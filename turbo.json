{
  "$schema": "https://turborepo.com/schema.json",
  "envMode": "strict",
  "futureFlags": {
    "affectedUsingTaskInputs": true
  },
  "globalDependencies": [
    ".nvmrc",
    "pnpm-workspace.yaml",
    "scripts/install-ci-tools.mjs",
    "tsconfig.json"
  ],
  "globalPassThroughEnv": ["EVE_TELEMETRY_DISABLED"],
  "tasks": {
    "//#check:deps": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.{ts,tsx,mts,cts,js,jsx,mjs,cjs,vue,svelte,md,mdx,css,sql,wgsl,py,png,svg,webp,woff2}"
      ],
      "tags": ["ci"]
    },
    "//#check:sandbox-image-tag": {
      "inputs": [
        "packages/eve/Dockerfile",
        "packages/eve/Dockerfile.git",
        "packages/eve/src/execution/sandbox/bindings/eve-image.ts",
        "scripts/sandbox-image-tag.mjs"
      ],
      "tags": ["ci"]
    },
    "//#check:templates": {
      "cache": false,
      "dependsOn": ["eve#build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!.agents/**",
        "!.changeset/**",
        "!.github/**",
        "!apps/benchmarks/**",
        "!apps/docs/**",
        "!apps/fixtures/**",
        "!apps/frameworks/**",
        "!apps/package-artifacts/**",
        "!docs/**",
        "!e2e/**",
        "!examples/**",
        "!packages/**",
        "!research/**"
      ],
      "passThroughEnv": ["EVE_SANDBOX_IMAGE_TAG"],
      "tags": ["ci", "ci:cpus:16"]
    },
    "//#check:template-files": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "!.agents/**",
        "!.changeset/**",
        "!.github/**",
        "!apps/benchmarks/**",
        "!apps/fixtures/**",
        "!apps/frameworks/**",
        "!apps/package-artifacts/**",
        "!docs/**",
        "!e2e/**",
        "!examples/**",
        "!packages/**",
        "!research/**"
      ],
      "tags": ["ci"]
    },
    "//#docs:check": {
      "dependsOn": ["eve#build:compiled"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!.agents/**",
        "!.changeset/**",
        "!.github/**",
        "!apps/**",
        "!e2e/**",
        "!examples/**",
        "!research/**"
      ],
      "tags": ["ci"]
    },
    "//#guard:docs-budget": {
      "cache": false,
      "tags": ["ci"]
    },
    "//#guard:fixtures": {
      "inputs": ["packages/eve/test/fixtures/**", "scripts/guard-test-fixtures.mjs"],
      "tags": ["ci"]
    },
    "//#guard:invariants": {
      "tags": ["ci"]
    },
    "//#lint": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.{md,mdx,yaml,yml,sql,css,wgsl,py,png,svg,webp,woff2,txt}"
      ],
      "tags": ["ci", "ci:cpus:4"]
    },
    "//#test:eval-benchmark": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "!.agents/**",
        "!.changeset/**",
        "!apps/**",
        "!docs/**",
        "!e2e/fixtures/**",
        "!examples/**",
        "!research/**"
      ],
      "tags": ["ci"]
    },
    "//#test:scripts": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "!.agents/**",
        "!apps/docs/**",
        "!apps/fixtures/**",
        "!apps/frameworks/**",
        "!apps/package-artifacts/**",
        "!apps/templates/**",
        "!docs/**",
        "!e2e/**",
        "!examples/**",
        "!research/**"
      ],
      "tags": ["ci"]
    },
    "build": {
      "dependsOn": ["^build"],
      "env": ["VERCEL"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!.eve/**",
        "!.next/**",
        "!.nuxt/**",
        "!.output/**",
        "!.svelte-kit/**",
        "!.turbo/**",
        "!.package/**",
        "!.package-staging-*/**",
        "!node_modules/**"
      ],
      "outputs": [
        "dist/**",
        ".package/**",
        ".next/**",
        "!.next/cache/**",
        ".output/**",
        ".vercel/output/**",
        "LICENSE",
        "NOTICE"
      ]
    },
    "build:types": {
      "dependsOn": ["^build:types"],
      "inputs": [
        "**/*.ts",
        "**/*.tsx",
        "**/*.cts",
        "**/*.mts",
        "**/*.d.ts",
        "tsconfig*.json",
        "package.json",
        "!.eve/**",
        "!.next/**",
        "!.nuxt/**",
        "!.output/**",
        "!.svelte-kit/**",
        "!.turbo/**",
        "!node_modules/**"
      ],
      "outputs": ["dist/**/*.d.ts", "dist/**/*.d.ts.map"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "cache": false,
      "inputs": [
        "$TURBO_DEFAULT$",
        "!.eve/**",
        "!.next/**",
        "!.nuxt/**",
        "!.output/**",
        "!.svelte-kit/**",
        "!.turbo/**",
        "!node_modules/**"
      ],
      "outputs": []
    },
    "e2e:dependencies": {
      "cache": false,
      "dependsOn": ["^build"]
    },
    "test:e2e": {
      "cache": false,
      "dependsOn": ["e2e:dependencies"],
      "env": [
        "AI_GATEWAY_API_KEY",
        "ANTHROPIC_API_KEY",
        "EVE_E2E_DUMP_CONTEXT",
        "EVE_E2E_MODEL",
        "EVE_E2E_WORKFLOW_WORLD",
        "EVE_SANDBOX_IMAGE_TAG",
        "GOOGLE_GENERATIVE_AI_API_KEY",
        "OPENAI_API_KEY"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!.eve/**",
        "!.next/**",
        "!.nuxt/**",
        "!.output/**",
        "!.svelte-kit/**",
        "!.turbo/**",
        "!node_modules/**"
      ],
      "outputs": []
    },
    "test:integration": {
      "cache": false,
      "tags": ["ci"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!.eve/**",
        "!.next/**",
        "!.nuxt/**",
        "!.output/**",
        "!.svelte-kit/**",
        "!.turbo/**",
        "!node_modules/**"
      ],
      "outputs": []
    },
    "test:scenario": {
      "cache": false,
      "dependsOn": ["^build"],
      "env": ["EVE_SANDBOX_IMAGE_TAG"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!.eve/**",
        "!.next/**",
        "!.nuxt/**",
        "!.output/**",
        "!.svelte-kit/**",
        "!.turbo/**",
        "!node_modules/**"
      ],
      "outputs": []
    },
    "test:unit": {
      "dependsOn": ["^build"],
      "tags": ["ci"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!.eve/**",
        "!.next/**",
        "!.nuxt/**",
        "!.output/**",
        "!.svelte-kit/**",
        "!.turbo/**",
        "!node_modules/**"
      ],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "tags": ["ci"],
      "inputs": [
        "**/*.ts",
        "**/*.tsx",
        "**/*.cts",
        "**/*.mts",
        "**/*.d.ts",
        "**/*.js",
        "**/*.mjs",
        "**/*.cjs",
        "**/*.jsx",
        "tsconfig*.json",
        "package.json",
        "!.eve/**",
        "!.next/**",
        "!.nuxt/**",
        "!.output/**",
        "!.svelte-kit/**",
        "!.turbo/**",
        "!node_modules/**"
      ],
      "outputs": []
    }
  }
}
